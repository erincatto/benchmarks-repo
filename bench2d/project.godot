; Benchmark project — 2D track (Rapier vs Box2D v3 vs Godot Physics 2D).
;
; The physics engine is NOT set here. run_bench.sh writes an override.cfg naming the engine
; for each run, because Godot only reads `physics/2d/physics_engine` at startup and there is
; no CLI flag for it.

config_version=5

[application]

config/name="Rapier Bench 2D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
; Read by launcher.gd and viewer.gd so the shared framework knows which track it is in.
config/bench_dim="2d"

[debug]

settings/stdout/verbose_stdout=false

[display]

; Without this a `--resolution 1920x1080` window is 1920x1080 *physical* pixels, which is
; only 960x540 points on a retina screen — small and awkward to frame when screen recording.
window/dpi/allow_hidpi=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=1
2d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="gl_compatibility"
