; Written for the benchmark rather than copied from upstream, for two reasons:
;
;   - upstream's file expects an un-suffixed `libgodot-box2c.macos.template_release.dylib`,
;     while an `arch=arm64` build emits the `.arm64` name used here;
;   - both `debug` and `release` point at the template_release binary, so the optimized
;     library is loaded no matter which context Godot decides it is running in. Pointing
;     `debug` at a debug build would silently benchmark an unoptimized Box2D.

[configuration]

entry_symbol = "godot_box2d_init"
compatibility_minimum = "4.3"

[libraries]

macos.debug = "bin/libgodot-box2c.macos.template_release.arm64.dylib"
macos.release = "bin/libgodot-box2c.macos.template_release.arm64.dylib"
